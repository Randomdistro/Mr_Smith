        },
        
        goalOrientation: {
          shortTermGoalFocus: { range: [1, 100], default: 50, description: "Emphasis on immediate objectives" },
          longTermGoalFocus: { range: [1, 100], default: 50, description: "Emphasis on distant objectives" },
