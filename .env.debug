# Debug Environment Configuration for NeoGPT Mr. Smith
# Copy this file to .env to use these settings

# Node Environment
NODE_ENV=development

# Smith API Configuration
SMITH_API_PORT=3000
SMITH_API_HOST=localhost
SMITH_API_PREFIX=/api/smith
SMITH_ENABLE_CORS=true

# Logging Configuration
SMITH_LOG_LEVEL=debug
SMITH_ENABLE_CONSOLE_LOGGING=true
SMITH_ENABLE_FILE_LOGGING=true
SMITH_LOG_FILE_PATH=./logs/smith-debug.log
SMITH_ENABLE_VERBOSE_ERRORS=true

# Agent Configuration
SMITH_MAX_AGENTS=20
SMITH_AGENT_ID_PREFIX=debug_
SMITH_REQUIRE_APPROVAL=false
SMITH_ALLOW_ANONYMOUS_AGENTS=true

# Storage Configuration
SMITH_DATA_PATH=./data/dev
SMITH_STORAGE_PATH=./storage/dev
SMITH_BACKUP_PATH=./backups/dev

# Performance Settings
SMITH_REQUEST_TIMEOUT=30000
SMITH_ENABLE_PROFILING=true
SMITH_PROFILE_PATH=./profiling

# WebScraperAgent Settings
WEBSCRAPER_MAX_CONCURRENT_REQUESTS=3
WEBSCRAPER_REQUEST_DELAY=3000
WEBSCRAPER_LOG_EXTRACTION_DETAILS=true
WEBSCRAPER_SAVE_RAW_HTML=true
WEBSCRAPER_MAX_TUTORIALS_PER_SOURCE=5

# Mock Oracle Settings (for testing)
SMITH_MOCK_ORACLE=true
SMITH_MOCK_ORACLE_AUTO_APPROVE=true

# Debug Flags
DEBUG=smith:*,agent:*,api:*,webScraper:*
DEBUG_COLORS=true
DEBUG_DEPTH=10

# Test URLs (comma-separated list for web scraper testing)
WEBSCRAPER_TEST_URLS=https://www.blender.org/tutorials/,https://knowledge.autodesk.com/support/autocad/learn

# Debugging Ports
DEBUG_PORT=9229
INSPECTOR_PORT=9229

# Memory Limits
NODE_OPTIONS=--max-old-space-size=4096

# Telemetry
SMITH_ENABLE_TELEMETRY=false
SMITH_TELEMETRY_ENDPOINT=http://localhost:4000/telemetry

# Security
SMITH_API_RATE_LIMIT=false
SMITH_API_MAX_REQUEST_SIZE=10mb 